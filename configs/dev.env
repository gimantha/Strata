# Development configuration for Strata.
#
#   set -a && source configs/dev.env && set +a
#
# Every setting has a documented default, so only the database URL is strictly required.
# Secrets belong in a secret manager, never in this file or any other committed file.

# --- Core ---------------------------------------------------------------------------
CG_ENV=dev
CG_SERVICE_NAME=strata
CG_LOG_LEVEL=info                  # debug, info, warn, error
CG_LOG_FORMAT=text                 # text for local work, json in deployments

# --- Canonical store ----------------------------------------------------------------
# The authoritative ledger. Graph, vector, and lexical stores are rebuildable
# projections of what lives here.
CG_DATABASE_URL=postgres://postgres@127.0.0.1:55432/strata
CG_DB_MAX_CONNS=10
CG_DB_MIN_CONNS=0
# Applies pending migrations at startup. Safe with several instances (the runner holds an
# advisory lock); set to false where migrations are a separate deployment step.
CG_AUTO_MIGRATE=true

# --- Raw archive --------------------------------------------------------------------
# Every ingested payload is archived here before its event is committed, so an assertion
# can always be traced back to the bytes it came from.
# Where raw source material is archived: fs or s3. The filesystem is correct and has no
# versioning or replication of its own, so protecting the bytes every claim is cited to
# becomes the deployment's problem; an object store hands that to the object store.
CG_BLOB_BACKEND=fs
CG_BLOB_DIR=./.data/blobs

# --- Object storage (CG_BLOB_BACKEND=s3) --------------------------------------------
# Any S3-compatible store: AWS, MinIO, R2, Ceph. scripts/dev-minio.sh start runs one.
# CG_S3_BUCKET=strata-artifacts
# CG_S3_PREFIX=production            # namespaces keys when two deployments share a bucket
# CG_S3_ENDPOINT=http://127.0.0.1:19000   # empty uses AWS's own endpoints
# CG_S3_REGION=us-east-1             # required by signing even where the provider ignores it
# Leave both credentials empty to use the ambient chain — environment, shared config,
# instance role — which is how a deployment on AWS holds no credentials at all.
# CG_S3_ACCESS_KEY_ID=
# CG_S3_SECRET_ACCESS_KEY=
# Required by most self-hosted stores, which have no wildcard DNS for virtual-host
# addressing. Leave false for AWS.
# CG_S3_PATH_STYLE=true

# --- API ----------------------------------------------------------------------------
CG_HTTP_ADDR=127.0.0.1:8080
CG_REQUEST_TIMEOUT=30s
CG_SHUTDOWN_TIMEOUT=20s
CG_MAX_BODY_BYTES=8388608
# Credentials for the HTTP API. Create one with:
#   go run ./cmd/cgctl keygen --principal ops-admin --system-role admin
CG_API_KEYS_FILE=./configs/api-keys.json

# --- Work fabric --------------------------------------------------------------------
# Run the outbox consumer inside contextgraphd. Convenient for single-node development;
# production runs cgworker separately.
CG_EMBEDDED_WORKER=false
CG_WORKER_CONCURRENCY=4
CG_WORKER_BATCH_SIZE=16
CG_WORKER_LEASE=60s                # must exceed CG_WORKER_POLL_INTERVAL
CG_WORKER_POLL_INTERVAL=500ms
CG_WORKER_MAX_ATTEMPTS=8
CG_BACKOFF_BASE=1s
CG_BACKOFF_MAX=5m
# 0 is uncapped. Set it when the fleet shares a rate-limited dependency: the limit is
# per worker, so the fleet-wide rate is this multiplied by the number of workers.
CG_WORKER_MAX_EVENTS_PER_SECOND=0
# How far the poll interval stretches while the queue is empty, so an idle fleet is
# quiet. With NATS configured, work arrives as a notification and this costs nothing.
CG_WORKER_IDLE_BACKOFF_MAX=5s

# --- Distributed delivery (optional) ------------------------------------------------
# Empty means the fleet polls the ledger, which is correct and simply slower to react.
# With a URL, NATS JetStream carries a notification about work that is already committed;
# the claim still happens in PostgreSQL, so exactly-once processing does not depend on
# the broker being healthy. scripts/dev-nats.sh start runs one locally.
# CG_NATS_URL=nats://127.0.0.1:14222
# Workers sharing a durable name share the queue. Distinct names mean distinct fleets.
CG_NATS_DURABLE=strata-workers
# Two deployments sharing one NATS cluster need distinct stream names: a work-queue stream
# may not overlap another stream's subjects, and the subject space is namespaced by this.
CG_NATS_STREAM=STRATA_WORK
CG_NATS_ACK_WAIT=60s
CG_NATS_MAX_ACK_PENDING=256

# --- Pipeline -----------------------------------------------------------------------
# Incrementing the pipeline version reprocesses events under a new run, leaving the
# previous run's history intact.
CG_PIPELINE_VERSION=1
CG_CHUNK_MAX_TOKENS=320
CG_CHUNK_OVERLAP_TOKENS=48

# --- Extraction ---------------------------------------------------------------------
# Optional. With no provider the pipeline still ingests, segments, and chunks.
#   none   no extraction
#   mock   scripted provider, for tests
#   openai any OpenAI-compatible endpoint
CG_LLM_PROVIDER=none
# CG_LLM_MODEL=gpt-4.1-mini
# CG_LLM_BASE_URL=http://localhost:11434/v1
# The key is read from the environment and never stored or logged. Keep it in a secret
# manager, not in this file.
# CG_LLM_API_KEY=
CG_LLM_TIMEOUT=60s
CG_LLM_MAX_RETRIES=2

# --- Retrieval projections ----------------------------------------------------------
# The embedder is optional: without one the lexical and graph projections still work.
# The schema holds 1536-dimension vectors, and a model of another width is refused at
# startup rather than at first use.
# hashing runs locally with no API key and gives vector retrieval real cosine structure.
CG_EMBEDDING_PROVIDER=hashing
# CG_EMBEDDING_MODEL=text-embedding-3-small
# CG_EMBEDDING_BASE_URL=http://localhost:11434/v1
# CG_EMBEDDING_API_KEY=

# --- Vector backend --------------------------------------------------------------------
# Where the vector projection lives: postgres or qdrant. The other two projections stay on
# PostgreSQL. The measurements in docs/api/performance.md say PostgreSQL is not the
# bottleneck at the scales tested, so this exists because the port is real rather than
# because the default is wrong. scripts/dev-qdrant.sh start runs one locally.
CG_VECTOR_BACKEND=postgres
# CG_QDRANT_HOST=127.0.0.1
# CG_QDRANT_PORT=16334          # the gRPC port, not the REST 16333
# CG_QDRANT_COLLECTION=strata_vectors
# CG_QDRANT_API_KEY=
# CG_QDRANT_USE_TLS=false

# --- Lexical backend -------------------------------------------------------------------
# Where the lexical projection lives: postgres or opensearch. As with the vector backend,
# this exists because the port is real rather than because the default is wrong —
# PostgreSQL's full-text search meets every section 39 target at the scales measured.
# scripts/dev-opensearch.sh start runs one locally.
CG_LEXICAL_BACKEND=postgres
# CG_OPENSEARCH_URL=http://127.0.0.1:19200
# CG_OPENSEARCH_INDEX=strata_lexical
# CG_OPENSEARCH_USER=
# CG_OPENSEARCH_PASSWORD=

# --- Graph backend ---------------------------------------------------------------------
# Where the graph projection lives: postgres or neo4j. As with the other two, this exists
# because the port is real rather than because the default is wrong.
# scripts/dev-neo4j.sh start runs one locally.
CG_GRAPH_BACKEND=postgres
# CG_NEO4J_URI=bolt://127.0.0.1:17687
# CG_NEO4J_USER=neo4j
# CG_NEO4J_PASSWORD=
# CG_NEO4J_DATABASE=            # empty uses the server default, which is what community offers

# --- Query planning --------------------------------------------------------------------
# How retrieval decides what to search for.
#   heuristic  reads the query's shape - identifier? short enough to be a name? Costs
#              nothing, never fails, never sends the question anywhere.
#   llm        reads its meaning. Can tell a requirement from a topic, break a compound
#              question apart, and sketch what an answer would look like for the vector leg.
#              Costs a model call per query and falls back to heuristic whenever it cannot
#              answer. Needs CG_LLM_PROVIDER, and cannot be combined with
#              CG_REDACT_QUERY_TEXT.
CG_QUERY_PLANNER=heuristic
CG_QUERY_PLANNER_TIMEOUT=5s

# --- Observability ------------------------------------------------------------------
# Unset means no-op providers: no collector is needed to run locally.
# CG_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
