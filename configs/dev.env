# Development configuration for Strata.
#
#   set -a && source configs/dev.env && set +a
#
# Every setting has a documented default, so only the database URL is strictly required.
# Secrets belong in a secret manager, never in this file or any other committed file.

# --- Core ---------------------------------------------------------------------------
CG_ENV=dev
CG_SERVICE_NAME=strata
CG_LOG_LEVEL=info                  # debug, info, warn, error
CG_LOG_FORMAT=text                 # text for local work, json in deployments

# --- Canonical store ----------------------------------------------------------------
# The authoritative ledger. Graph, vector, and lexical stores are rebuildable
# projections of what lives here.
CG_DATABASE_URL=postgres://postgres@127.0.0.1:55432/strata
CG_DB_MAX_CONNS=10
CG_DB_MIN_CONNS=0
# Applies pending migrations at startup. Safe with several instances (the runner holds an
# advisory lock); set to false where migrations are a separate deployment step.
CG_AUTO_MIGRATE=true

# --- Raw archive --------------------------------------------------------------------
# Every ingested payload is archived here before its event is committed, so an assertion
# can always be traced back to the bytes it came from.
CG_BLOB_DIR=./.data/blobs

# --- API ----------------------------------------------------------------------------
CG_HTTP_ADDR=127.0.0.1:8080
CG_REQUEST_TIMEOUT=30s
CG_SHUTDOWN_TIMEOUT=20s
CG_MAX_BODY_BYTES=8388608
# Credentials for the HTTP API. Create one with:
#   go run ./cmd/cgctl keygen --principal ops-admin --system-role admin
CG_API_KEYS_FILE=./configs/api-keys.json

# --- Work fabric --------------------------------------------------------------------
# Run the outbox consumer inside contextgraphd. Convenient for single-node development;
# production runs cgworker separately.
CG_EMBEDDED_WORKER=false
CG_WORKER_CONCURRENCY=4
CG_WORKER_BATCH_SIZE=16
CG_WORKER_LEASE=60s                # must exceed CG_WORKER_POLL_INTERVAL
CG_WORKER_POLL_INTERVAL=500ms
CG_WORKER_MAX_ATTEMPTS=8
CG_BACKOFF_BASE=1s
CG_BACKOFF_MAX=5m

# --- Pipeline -----------------------------------------------------------------------
# Incrementing the pipeline version reprocesses events under a new run, leaving the
# previous run's history intact.
CG_PIPELINE_VERSION=1
CG_CHUNK_MAX_TOKENS=320
CG_CHUNK_OVERLAP_TOKENS=48

# --- Extraction ---------------------------------------------------------------------
# Optional. With no provider the pipeline still ingests, segments, and chunks.
#   none   no extraction
#   mock   scripted provider, for tests
#   openai any OpenAI-compatible endpoint
CG_LLM_PROVIDER=none
# CG_LLM_MODEL=gpt-4.1-mini
# CG_LLM_BASE_URL=http://localhost:11434/v1
# The key is read from the environment and never stored or logged. Keep it in a secret
# manager, not in this file.
# CG_LLM_API_KEY=
CG_LLM_TIMEOUT=60s
CG_LLM_MAX_RETRIES=2

# --- Observability ------------------------------------------------------------------
# Unset means no-op providers: no collector is needed to run locally.
# CG_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
